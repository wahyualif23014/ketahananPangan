# ============================================================
#  .env.docker.example — Template for Docker Environment
# ============================================================
#  Copy this to .env.docker and fill in the values:
#    cp .env.docker.example .env.docker
# ============================================================

# ── App Key ────────────────────────────────────────────────
# Generate with: docker compose exec app php artisan key:generate --show
APP_KEY=base64:CHANGE_ME_GENERATE_A_REAL_KEY

# ── MySQL ──────────────────────────────────────────────────
# Password for user "ketahanan" (used by Laravel app)
DB_PASSWORD=secret123
MYSQL_PASSWORD=secret123

# Password for MySQL root user
MYSQL_ROOT_PASSWORD=rootsecret123

# ── phpMyAdmin ─────────────────────────────────────────────
PMA_PASSWORD=rootsecret123
